generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum AttemptStatus {
  STARTED
  SENT
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  campaigns Campaign[]
}

model Sender {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  email          String
  displayName    String?
  smtpAccountKey String?
  hourlyLimit    Int      @default(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emails    Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  senderId             String   @db.Uuid
  subject              String
  body                 String   @db.Text
  startAt              DateTime
  delayBetweenEmailsMs Int      @default(2000)
  hourlyLimit          Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender  @relation(fields: [senderId], references: [id])
  emails Email[]

  @@index([userId, createdAt])
}

model Email {
  id                String      @id @default(uuid()) @db.Uuid
  campaignId        String      @db.Uuid
  senderId          String      @db.Uuid
  recipient         String
  subject           String
  body              String      @db.Text
  scheduledAt       DateTime
  status            EmailStatus @default(SCHEDULED)
  idempotencyKey    String      @unique
  bullJobId         String?     @unique
  attempts          Int         @default(0)
  providerMessageId String?
  sentAt            DateTime?
  lastError         String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender       Sender            @relation(fields: [senderId], references: [id])
  attemptLogs  EmailAttempt[]
  outboxEvents OutboxEvent[]
  attachments  EmailAttachment[]

  @@unique([campaignId, recipient])
  @@index([status, scheduledAt])
  @@index([senderId, scheduledAt])
  @@index([campaignId, status])
}

model EmailAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  emailId           String        @db.Uuid
  attemptNumber     Int
  status            AttemptStatus @default(STARTED)
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  providerMessageId String?
  errorMessage      String?       @db.Text

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, attemptNumber])
  @@index([emailId, startedAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  emailId     String    @db.Uuid
  eventType   String    @default("SCHEDULE_EMAIL")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, eventType])
  @@index([publishedAt, createdAt])
}

model EmailAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  emailId      String   @db.Uuid
  originalName String
  mimeType     String
  storagePath  String
  size         Int
  createdAt    DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}
